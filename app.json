{
  "expo": {
    "name": "IDA Ciudadano",
    "slug": "ida-ciudadano",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "iovf-ida-demo-wallet",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "jsEngine": "hermes"
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.iovf.driverlicensemobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d2af94dd-a6e1-4586-852d-3c40b85f4d28"
      }
    },
    "owner": "vincentes",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/67564153-fced-432c-b065-bc90c9cdd821"
    }
  }
}
