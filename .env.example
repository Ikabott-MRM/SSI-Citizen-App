# Local / default: mirrors EAS "preview" (staging API + Rootstock testnet).
# Copy to .env and adjust. EAS profiles override these for cloud builds (see eas.json).

EXPO_PUBLIC_API_BASE_URL=https://pxsmhnkq4i.execute-api.us-east-1.amazonaws.com
EXPO_PUBLIC_API_KEY=api-key-for-interacting-with-API-endpoints

# Rootstock: chain 31 = testnet, 30 = mainnet (production EAS profile uses mainnet + docs/identity contract).
EXPO_PUBLIC_WEB3_CHAIN_ID=31
EXPO_PUBLIC_WEB3_RPC_URL=https://public-node.testnet.rsk.co
EXPO_PUBLIC_WEB3_CONTRACT_ADDRESS=0x64dB8b2ccD86d4A36b7F9B9F8A3eA2F35fA86c2a

EXPO_PUBLIC_IPFS_GATEWAY_BASE_URL=https://gateway.pinata.cloud

# Optional override for ethers network name (defaults: chain 30 -> rootstock, 31 -> rootstock-testnet).
# EXPO_PUBLIC_WEB3_NETWORK_NAME=rootstock
